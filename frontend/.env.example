# Copy to frontend/.env . Vite only exposes variables prefixed with VITE_.
# These are browser-visible by design: the anon key is safe to ship ONLY
# because Row Level Security restricts it to SELECT. Never put the service
# role key or the Postgres password in this file.

VITE_API_BASE=/api

# Supabase > Settings > API
VITE_SUPABASE_URL=https://croppaplncboxqdcnlbu.supabase.co
VITE_SUPABASE_ANON_KEY=

# Must match DEFAULT_DEVICE_ID in backend/.env
VITE_DEFAULT_DEVICE_ID=esp8266-01
