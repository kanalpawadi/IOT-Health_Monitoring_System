# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill in the real values.
# backend/.env is gitignored -- never commit it.
# ---------------------------------------------------------------------------

# Supabase > Settings > Database > Connection string > URI
# Use the *Session pooler* URI if your network has no IPv6 route to db.*
# Example (direct):  postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres
# Example (pooler):  postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase > Settings > API. The frontend needs these too (see frontend/.env).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Groq -- free key from https://console.groq.com/keys
# Leave blank and the system falls back to deterministic template summaries,
# so the dashboard still works without it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Monitoring behaviour
# ---------------------------------------------------------------------------
DEFAULT_DEVICE_ID=esp8266-01
TREND_WINDOW_MINUTES=15
PERSISTENCE_SAMPLES=3
ALERT_COOLDOWN_SECONDS=180
OFFLINE_AFTER_SECONDS=60
AI_CACHE_SECONDS=120

# Optional shared secret the ESP8266 must send as X-Device-Key when posting
# to /api/ingest. Leave blank to keep that endpoint open.
INGEST_KEY=

# Comma-separated list of allowed dashboard origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
